{
	"name": "obsidian-markdown-to-canvas",
	"version": "1.0.0",
	"description": "An Obsidian plugin to convert structured Markdown notes into Canvas mind maps.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest"
	},
	"keywords": [
		"obsidian",
		"obsidian-md",
		"obsidian-plugin",
		"canvas",
		"mindmap"
	],
	"author": "Dhruv",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"jest": "^30.0.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.0",
		"tslib": "2.4.0",
		"typescript": "^4.7.4"
	}
}
